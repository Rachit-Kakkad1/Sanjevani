# ═══════════════════════════════════════════
# 🏥 Sanjevani Backend — Environment Config
# ═══════════════════════════════════════════
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/sanjevani

# OCR Service (Hugging Face Space Live Deployment)
OCR_SERVICE_URL=https://rachit-ai-sanjeevani-ocr.hf.space/ocr/extract
OCR_API_URL=https://rachit-ai-sanjeevani-ocr.hf.space
USE_MOCK_OCR=false
OCR_TIMEOUT_MS=60000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# JWT
JWT_SECRET=your_jwt_secret_here
