{
  "framework": "vite",
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/mappls-auth/:path*", "destination": "https://outpost.mappls.com/:path*" },
    { "source": "/mappls-api/:path*", "destination": "https://atlas.mappls.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
